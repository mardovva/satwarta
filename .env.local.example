# MAP_KEY NASA FIRMS (gratis): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Gemini API (Google AI Studio, ada tingkat gratis): https://aistudio.google.com/apikey
